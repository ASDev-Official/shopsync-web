{
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/docs",
      "dest": "/docs/index.html"
    },
    {
      "src": "/docs/",
      "dest": "/docs/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
