{
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  @@  "routes": [
  @@    {
  @@      "src": "/docs(?:/(.*?))?$",
  @@      "status": 200,
  @@      "continue": true
  @@    },
  @@    {
  @@      "src": "^/(.*?)(?:\\.html)?/?$",
  @@      "destination": "/index.html",
  @@      "status": 200
  @@    },
  @@    {
  @@      "src": "^/.*$",
  @@      "status": 404
  @@    }
  @@  ]
}
